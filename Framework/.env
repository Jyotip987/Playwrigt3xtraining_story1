# Copy to .env and fill in:  cp .env.example .env

# Which environment to target: qa | stg | prod | dev | api
# Ignored when BASE_URL is set, so leave BASE_URL empty to switch with TTA_ENV.
TTA_ENV=qa
BASE_URL=

QA_BASE_URL=https://app.thetestingacademy.com
STG_BASE_URL=https://stage.thetestingacademy.com
PROD_BASE_URL=https://app.thetestingacademy.com
DEV_BASE_URL=http://localhost:3000
API_BASE_URL=https://restful-booker.herokuapp.com

LOG_LEVEL=info

# Shown in the header of the TTA custom report
TEST_ENV=QA
TEST_AUTHOR=your_name

# TTACart login (src/config/credentials.ts). Leave blank for the demo login:
# standard_user / tta_secret
STANDARD_USER=standard_user
TTA_SECRET=

# Restful Booker /auth login (src/tests/apiTests). Public demo credentials.
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# true attaches a screenshot to every visualStep() in the TTA report
ATTACH_SCREENSHOTS=false

# Optional: a fixed checkout customer for DataGenerator.checkoutCustomerFromEnv().
# Any field left unset is generated with Faker.
# CHECKOUT_FIRST_NAME=
# CHECKOUT_LAST_NAME=
# CHECKOUT_POSTAL_CODE=

# Optional: enables the AI Verdict tab in the TTA report (any one key)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# LLM Gateway  (src/AI/LLMGateway.ts)
# ─────────────────────────────────────────────────────────────────────────────
#
# COMPANY POLICY CONTROLS
# ───────────────────────
# LLM_PROVIDER            Which provider to use:
#                           gemini | groq | openrouter | openai | anthropic | deepseek | github
#                         Leave empty → auto-pick the first provider whose key is present.
#                         Auto-pick order: gemini → groq → openrouter → deepseek → openai → anthropic → github
LLM_PROVIDER=gemini
#
# LLM_ALLOWED_PROVIDERS   Comma-separated allowlist. The gateway REJECTS any provider not listed.
#                         Leave empty / unset → all providers are allowed.
#                         Example: LLM_ALLOWED_PROVIDERS=gemini,groq
# LLM_ALLOWED_PROVIDERS=
#
# LLM_TIMEOUT_MS          Per-request HTTP timeout in milliseconds (default 60000).
# LLM_TIMEOUT_MS=60000
#
# LLM_MAX_RETRIES         Retry count on 5xx / network errors (default 2).
# LLM_MAX_RETRIES=2
#
# PROVIDER KEYS  (uncomment the one(s) your company allows)
# ─────────────────────────────────────────────────────────
#
# 0. Google Gemini — powers Antigravity AI (free tier available)
#    Keys: https://aistudio.google.com/apikey
#    Also accepts GOOGLE_API_KEY (already used by the reporter above).
 GEMINI_API_KEY=AQ.Ab8RN6L94ml-GTCWLHDRGajjflGLtoe7Q6r9QSzGbQJRyj7SMg
# GEMINI_MODEL=gemini-2.0-flash
#
# 1. Groq — free, fast, llama-3.3-70b
#    Keys: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# 2. OpenRouter — free ":free" models (many providers in one API)
#    Keys: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# 3. OpenAI — gpt-4o-mini (cheapest paid tier)
#    Keys: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# 4. Anthropic (Claude) — claude-haiku is the most affordable
#    Keys: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# 5. DeepSeek — direct API, very cost-effective
#    Keys: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
#
# 6. GitHub Models — free via GitHub PAT (models:read scope)
#    Docs: https://docs.github.com/en/github-models
# GITHUB_TOKEN=
# GITHUB_MODEL=gpt-4o-mini

# Optional: MySQL for data-driven tests (src/utils/dbReader.ts)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=playwright_ddt